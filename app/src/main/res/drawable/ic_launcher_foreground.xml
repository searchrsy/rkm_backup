<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kanvas transparan 108dp (persegi) supaya ikon & splash tidak jadi persegi panjang -->
    <item
        android:width="108dp"
        android:height="108dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Logo SPI di tengah (rasio sama dengan ic_rkm_logo.png) -->
    <item
        android:width="58dp"
        android:height="25.3dp"
        android:drawable="@drawable/ic_rkm_logo"
        android:gravity="center" />
</layer-list>